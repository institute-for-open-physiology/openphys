<resources>
    <style name="Theme.TrainingSensors" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">@color/ink</item>
        <item name="colorControlNormal">@color/muted</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="buttonStyle">@style/TrainingSensors.Button</item>
    </style>
    <style name="TrainingSensors.Button" parent="Widget.AppCompat.Button">
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/canvas</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
